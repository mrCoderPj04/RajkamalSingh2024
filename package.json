{
  "name": "sofo-sync",
  "version": "1.0.0",
  "private": true,
  "description": "SOFO Sync - One QR. Instant Connection. Real-Time Collaboration.",
  "workspaces": [
    "apps/web",
    "apps/desktop",
    "apps/mobile",
    "backend/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sofo-sync/web",
    "dev:web": "npm run dev --workspace=@sofo-sync/web",
    "dev:backend": "npm run dev --workspace=@sofo-sync/api",
    "build": "npm run build --workspace=@sofo-sync/web",
    "start": "npm run start --workspace=@sofo-sync/web",
    "lint": "npm run lint --workspace=@sofo-sync/web"
  },
  "keywords": [
    "sofo-sync",
    "qr-code",
    "realtime-collaboration",
    "whiteboard",
    "documents",
    "webrtc",
    "monorepo"
  ],
  "author": "SOFO Sync Team",
  "license": "MIT",
  "dependencies": {
    "caniuse-lite": "^1.0.30001806",
    "compression": "^1.8.1",
    "debug": "^4.4.3",
    "http-errors": "^2.0.1",
    "statuses": "^2.0.2",
    "stream-buffers": "^3.0.3"
  }
}
