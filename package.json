    "start": "npm run start --workspace=@sofo-sync/web",
    "lint": "npm run lint --workspace=@sofo-sync/web"
  },
  "keywords": [
    "sofo-sync",
    "qr-code",
    "realtime-collaboration",
    "whiteboard",
