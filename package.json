{
  "name": "sofo-sync",
  "version": "1.0.0",
  "private": true,
  "description": "SOFO Sync - One QR. Instant Connection. Real-Time Collaboration.",
  "workspaces": [
    "apps/*",
    "backend/*",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@sofo-sync/web",
